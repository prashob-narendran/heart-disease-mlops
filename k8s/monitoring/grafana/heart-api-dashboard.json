    {
      "type": "bargauge",
      "title": "Distribution of predicted disease probability (time range)",
      "id": 18,
      "description": "How many patients fell into each probability bucket. A shift between periods hints at input drift.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(heart_api_prediction_probability_bucket[$__range]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "heatmap"
        }
      ],
      "options": {
        "orientation": "vertical",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
